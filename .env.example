# ============================================================
# JUDGE PROVIDER CONFIGURATION
# ============================================================
# Select your LLM provider for evaluation
# Options: gemini, ollama, openai, anthropic
JUDGE_PROVIDER=gemini

# ============================================================
# GEMINI CONFIGURATION (Google AI)
# ============================================================
# Required when JUDGE_PROVIDER=gemini
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ============================================================
# OLLAMA CONFIGURATION (Local LLM)
# ============================================================
# Required when JUDGE_PROVIDER=ollama
# Install Ollama from: https://ollama.ai
# Start Ollama: ollama serve
# Pull model: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# OPENAI CONFIGURATION
# ============================================================
# Required when JUDGE_PROVIDER=openai
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# ANTHROPIC CONFIGURATION (Claude)
# ============================================================
# Required when JUDGE_PROVIDER=anthropic
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============================================================
# SHARED SETTINGS
# ============================================================
# Cosine similarity threshold for registry overlap detection (0.0-1.0)
SIMILARITY_THRESHOLD=0.8

# Path to the persistent skill registry database
REGISTRY_DB_PATH=registry.db

# ============================================================
# STAGE WEIGHTS (must sum to 1.0)
# ============================================================
# How much each pipeline stage contributes to the final score
# WEIGHT_STAGE_1=0.10
# WEIGHT_STAGE_2=0.20
# WEIGHT_STAGE_3=0.10
# WEIGHT_STAGE_4=0.60

# ============================================================
# STAGE 4 SUB-WEIGHTS (must sum to 1.0)
# ============================================================
# How much each evaluation sub-stage contributes within Stage 4
# WEIGHT_S4_ROUTING=0.35
# WEIGHT_S4_OUTPUT_QUALITY=0.25
# WEIGHT_S4_ASSERTION_GRADING=0.25
# WEIGHT_S4_BENCHMARK=0.15

# ============================================================
# TIER THRESHOLDS
# ============================================================
# Minimum final score required for each certification tier
# TIER_PREMIUM_MIN_SCORE=0.9
# TIER_GOLD_MIN_SCORE=0.8
# TIER_SILVER_MIN_SCORE=0.7
